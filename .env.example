# OpenRouter API Key（必填）
# 获取地址：https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter 模型（可选，默认 openai/gpt-5.5）
# OPENROUTER_MODEL=openai/gpt-5.5

# 请求超时毫秒数（可选，默认 60000）
# OPENROUTER_TIMEOUT_MS=60000

# 搜索结果最大条数（可选，默认 3，最大 5）
# OPENROUTER_SEARCH_MAX_RESULTS=3

# 运行时数据目录（自动检测 Vercel，通常无需手配）
# 如需覆盖：KOUBO_RUNTIME_DIR=/custom/path
